; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="幽影深渊"
config/description="Gloamrift · 网页版一比一移植"
run/main_scene="res://scenes/title.tscn"
config/features=PackedStringArray("4.7")
config/icon="res://icon.svg"

[autoload]

Cfg="*res://autoload/Cfg.gd"
Data="*res://autoload/Data.gd"
LootData="*res://autoload/LootData.gd"
Sfx="*res://autoload/Sfx.gd"
Assets="*res://autoload/Assets.gd"
Game="*res://autoload/Game.gd"
WorldState="*res://autoload/WorldState.gd"
UiKit="*res://scripts/UiKit.gd"
TalkData="*res://scripts/TalkData.gd"
AchData="*res://scripts/AchData.gd"
ThreadPool="*res://autoload/ThreadPool.gd"
EventBus="*res://autoload/EventBus.gd"
Notify="*res://autoload/Notify.gd"

[display]

window/size/viewport_width=1980
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom_font="res://fonts/NotoSansSC-Regular.ttf"

