extends Node
## 网页版 NPC 寒暄与打听（静态答句）。


static func greet(id: String) -> String:
	if Game.P.get("nameForgotten") and (id == "selin" or id == "bridge"):
		return "你叫……裂口又偷了。去桥头念一遍，我就想得起。" if id == "selin" else "裂口把名字偷了。牌子上刻着呢。念一遍。"
	if id == "selin" and not Game.P.flags.get("metSelin", false):
		Game.P.flags.metSelin = true
		return "裂口在镇底下。东西已经爬上来了。东边荒原，狼群在咬牲口。去砍。砍完回来。"
	var ch := Game.ch_now()
	var g := {
		"selin": {1: "活还在板上。去干。", 2: "北面冻死了。钟从湖底往上爬。去砸。砸完回来。", 3: "海岸在死人。船是被凿沉的。下去把那个人的手打断。", 4: "从裂口下去。底下有个厅在开会。把会开停。", 5: "最底下那个要挣出来。跟我走。这一次打完，这件事结束。"},
		"kaden": {1: "黑铁放下。角落那些箱子也是，金放下就拿走。", 2: "霜结符文嵌上。北境的冰会咬铁。", 3: "盐会锈刀。回来我给你去一层油。", 4: "这地方的铁都在往下沉。锤还听我的。", 5: "楔子对桥墩，不是对人。"},
		"mara": {1: "地下带上来的会糊。给我看，我帮你认。红的止血，蓝的醒神。别省。", 2: "薄冰吃体温。药随身，别站着看湖。", 3: "盐进伤口会醒。退潮再打。", 4: "下面的空气是苦的。多带蓝的。", 5: "苦药我备着。你先活着走到井底。"},
		"vaun": {1: "一到三为小，四到六为大。猜对了桌上随便抓。裂口不赌，裂口直接拿。", 2: "北边冷。金币冻在口袋里也是金币。", 3: "船沉了货还在赌。你要不要。", 4: "这镇往下沉。我的桌还平。", 5: "最后一注：你能不能按住他。"},
		"bridge": {1: "名字刻上。裂口爱偷这个。被偷了就回这儿念一遍。执政官在广场北面。她有活。", 2: "北面的风把名字也冻住。回来还是念。", 3: "潮声像有人在数船。十一条。别数。", 4: "桥还在。镇有的已经不在上面了。", 5: "念一遍。下去之前再念一遍。"},
		"harun": {2: "钟一响，隘口这面先哑。你还听得见自己的名字，就算运气好。"},
		"wick": {3: "三盏灯。亮了再看浅滩。涨潮就回来。"},
		"quill": {4: "账还没写完。地先陷了。你是来把会开停的？"},
		"nock": {5: "七根还在。最底下那个在挣。别让他出来。"}
	}
	if not g.has(id):
		return "……"
	var row: Dictionary = g[id]
	if row.has(ch):
		return str(row[ch])
	for k in [1, 2, 3, 4, 5]:
		if row.has(k):
			return str(row[k])
	return "……"


static func topics(id: String) -> Array:
	var table: Dictionary = _all()
	var all: Array = table.get(id, []) as Array
	var out: Array = []
	for t in all:
		if int(t.get("need", 1)) > 1 and not Game.ch_open(int(t.need)):
			continue
		out.append(t)
	return out


static func answer(id: String, tid: String) -> String:
	if tid == "job":
		var q := Game.active_quest()
		return str(q.d) if not q.is_empty() else "活干完了。裂口还在。你自己决定还要不要下去。"
	for t in topics(id):
		if str(t.id) == tid:
			return str(t.a)
	return ""


