extends Node
## 网页版 NPC 寒暄与打听（静态答句）。文案直接、短促，三秒知道去哪杀谁。


static func greet(id: String) -> String:
	if Game.P.get("nameForgotten") and (id == "selin" or id == "bridge"):
		return "你叫……裂口又弄乱了。去桥头念一遍，我就想起来。" if id == "selin" else "裂口把名字弄乱了。牌子上刻着呢。念一遍。"
	if id == "selin" and not Game.P.flags.get("metSelin", false):
		Game.P.flags.metSelin = true
		return "裂口在镇子底下，怪物从下面爬上来了。东边荒原有狼在咬牲口，去砍。砍完回来。"
	var ch := Game.ch_now()
	var g := {
		"selin": {1: "活还堆着。去干。", 2: "北面冻住了。湖底有口钟在响，去砸了它。", 3: "海岸有沉船，船是被凿穿的。下去把那个凿船的宰了。", 4: "裂口底下有个大厅在开会，去把会搅散。", 5: "最底下的那个东西要爬出来了。跟我下去，这次打完就结束。"},
		"kaden": {1: "黑铁放这。角落的箱子也能开，放下金币就拿。", 2: "北边的冰会冻住铁。我给你嵌个霜符，刀就不粘。", 3: "盐会锈刀。回来我给你上油。", 4: "这地方的铁都在往下沉，但我的锤子还听使唤。", 5: "钉子是钉桥用的，不是钉人。"},
		"mara": {1: "地下捞上来的东西会糊成一团。拿给我看，我帮你认。红的回血，蓝的回神。别省着。", 2: "湖面薄冰会吸体温。药随身带，别在湖边站着看。", 3: "盐进伤口更疼。退潮再打。", 4: "底下空气发苦。多带蓝药。", 5: "苦药我备着。你先活着走到井底。"},
		"vaun": {1: "骰子一到三算小，四到六算大。猜对了随便拿。裂口不赌，它直接抢。", 2: "北边冷，但金币冻在口袋里还是金币。", 3: "船沉了，货还在。你要不要赌一把。", 4: "这镇往下沉，但我的桌子还是平的。", 5: "最后一注：你能不能按住他。"},
		"bridge": {1: "名字刻在牌子上。裂口会弄乱你的名字，弄乱了就回来念一遍。执政官在广场北面，她有活给你。", 2: "北风连名字都能冻住。回来还是念一遍。", 3: "潮声像在数船。十一条。别跟着数。", 4: "桥还在。镇上有些东西已经不在上面了。", 5: "下去之前再念一遍。"},
		"harun": {2: "钟一响，隘口这边的人先听不见自己名字。你还听得见，就算走运。"},
		"wick": {3: "三盏灯。亮了再看浅滩。涨潮就回岸。"},
		"quill": {4: "账还没记完，地先塌了。你是来把那场会搅散的？"},
		"nock": {5: "七根钉子还在。最底下的那个在挣。别放他出来。"}
	}
	if not g.has(id):
		return "……"
	var row: Dictionary = g[id]
	if row.has(ch):
		return str(row[ch])
	for k in [1, 2, 3, 4, 5]:
		if row.has(k):
			return str(row[k])
	return "……"


static func topics(id: String) -> Array:
	var table: Dictionary = _all()
	var all: Array = table.get(id, []) as Array
	var out: Array = []
	for t in all:
		if int(t.get("need", 1)) > 1 and not Game.ch_open(int(t.need)):
			continue
		out.append(t)
	return out


static func answer(id: String, tid: String) -> String:
	if tid == "job":
		var q := Game.active_quest()
		return str(q.d) if not q.is_empty() else "活干完了。裂口还在。你自己决定还要不要下去。"
	for t in topics(id):
		if str(t.id) == tid:
			return str(t.a)
	return ""


